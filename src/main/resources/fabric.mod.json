{
  "schemaVersion": 1,
  "id": "netheriteextras",
  "version": "${version}",
  "name": "Netherite Extras",
  "description": "Adds extra uses for Netherite.",
  "authors": [
    "SLH"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/netherite-extras",
    "sources": "https://github.com/SLH335/netherite-extras"
  },
  "license": "GPL-3.0",
  "icon": "assets/netheriteextras/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.slh.netheriteextras.NetheriteExtras"
    ],
    "client": [
      "dev.slh.netheriteextras.client.NetheriteExtrasClient"
    ],
    "modmenu": [
      "dev.slh.netheriteextras.client.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "netheriteextras.mixins.json",
    {
      "config": "netheriteextras.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.7"
  },
  "suggests": {
    "modmenu": "*"
  }
}
